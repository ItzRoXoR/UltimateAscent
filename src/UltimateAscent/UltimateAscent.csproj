<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UltimateAscent</AssemblyName>
    <RootNamespace>UltimateAscent</RootNamespace>
    <Version>1.5.4</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <!-- Keeps the local folder names out of the built DLL (its debug path). -->
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
    <!-- Harmony patch classes and Unity callbacks are found by reflection. -->
    <NoWarn>$(NoWarn);IDE0051;IDE0060;CS0649;CS0169;CS0618</NoWarn>
  </PropertyGroup>

  <!--
    Paths can be overridden on the command line, e.g.
      dotnet build -c Release -p:PeakDir="D:\SteamLibrary\steamapps\common\PEAK"
  -->
  <PropertyGroup>
    <PeakDir Condition="'$(PeakDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PEAK</PeakDir>
    <ManagedDir>$(PeakDir)\PEAK_Data\Managed</ManagedDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\PEAK\profiles\FinalAscent</ProfileDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(ProfileDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game's own Alpine snowstorm visuals (particles, material, fog texture), for maps without an Alpine biome. -->
    <EmbeddedResource Include="Resources\NativeAlpineSnow.bundle" LogicalName="UltimateAscent.NativeAlpineSnow.bundle" />
    <!-- A chalk-bag model for the Climbing Chalk, whose prefab only has Unity's placeholder cube. -->
    <EmbeddedResource Include="Resources\ClimbingChalk.obj" LogicalName="UltimateAscent.ClimbingChalk.obj" />
    <EmbeddedResource Include="Resources\ClimbingChalk_palette.png" LogicalName="UltimateAscent.ClimbingChalk_palette.png" />
    <!-- Its inventory icon (rendered from the model), the chalked-hands icon shown above the stamina bar,
         and its hand-rub sound (16-bit PCM, levelled to the game's item sounds). -->
    <EmbeddedResource Include="Resources\ClimbingChalk_icon.png" LogicalName="UltimateAscent.ClimbingChalk_icon.png" />
    <EmbeddedResource Include="Resources\ClimbingChalk_status.png" LogicalName="UltimateAscent.ClimbingChalk_status.png" />
    <EmbeddedResource Include="Resources\ClimbingChalk_rub.wav" LogicalName="UltimateAscent.ClimbingChalk_rub.wav" />
    <!-- The hands of every outfit's body mesh (from the game files), for the chalk's white hands. -->
    <EmbeddedResource Include="Resources\ClimbingChalk_hands.bin" LogicalName="UltimateAscent.ClimbingChalk_hands.bin" />
    <!-- The Lightweight Parasol's look (the user's recolour): its icon, and the parasol's two canopy meshes
         (from the game files) with every vertex marked by its stripe. -->
    <EmbeddedResource Include="Resources\LightweightParasol_icon.png" LogicalName="UltimateAscent.LightweightParasol_icon.png" />
    <EmbeddedResource Include="Resources\LightweightParasol_canopy.bin" LogicalName="UltimateAscent.LightweightParasol_canopy.bin" />
    <!-- The six-slot Backpack (single-player): its worn and ground meshes and pouch anchors (tools/SixSlotBackpack/build_mesh.py). -->
    <EmbeddedResource Include="Resources\SixSlotBackpack.bin" LogicalName="UltimateAscent.SixSlotBackpack.bin" />
    <EmbeddedResource Include="Resources\SixSlotBackpack_icon.png" LogicalName="UltimateAscent.SixSlotBackpack_icon.png" />
    <!-- The mod's cosmetics' passport icons (the game's Astronaut icons recoloured; the VR Headset rendered in game). -->
    <EmbeddedResource Include="Resources\OrangeHelmet_icon.png" LogicalName="UltimateAscent.OrangeHelmet_icon.png" />
    <EmbeddedResource Include="Resources\OrangeSpacesuit_icon.png" LogicalName="UltimateAscent.OrangeSpacesuit_icon.png" />
    <EmbeddedResource Include="Resources\VRHeadset_icon.png" LogicalName="UltimateAscent.VRHeadset_icon.png" />
    <!-- The Stone's break: the smash at 4 s of the user's rock-smash clip (mono, 16-bit PCM). -->
    <EmbeddedResource Include="Resources\Stone_break.wav" LogicalName="UltimateAscent.Stone_break.wav" />
    <EmbeddedResource Include="Resources\Nausea_stomach.wav" LogicalName="UltimateAscent.Nausea_stomach.wav" />
    <EmbeddedResource Include="Resources\PinkLollipop.png" LogicalName="UltimateAscent.PinkLollipop.png" />
    <EmbeddedResource Include="Resources\PinkLollipop_icon.png" LogicalName="UltimateAscent.PinkLollipop_icon.png" Condition="Exists('Resources\PinkLollipop_icon.png')" />
    <EmbeddedResource Include="Resources\ToxicDrink.png" LogicalName="UltimateAscent.ToxicDrink.png" />
    <EmbeddedResource Include="Resources\ToxicDrink_icon.png" LogicalName="UltimateAscent.ToxicDrink_icon.png" Condition="Exists('Resources\ToxicDrink_icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime" Publicize="true">
      <HintPath>$(ManagedDir)\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.PhotonUtility">
      <HintPath>$(ManagedDir)\Zorro.PhotonUtility.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Settings.Runtime">
      <HintPath>$(ManagedDir)\Zorro.Settings.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="pworld">
      <HintPath>$(ManagedDir)\pworld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
